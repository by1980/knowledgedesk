# Copy this file to .env and fill it in:  cp .env.example .env

# Shown in the app
COMPANY_NAME=Example Ltd

# First admin login (created on first start; change the password after logging in)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Long random text used to sign logins. Generate one with:  openssl rand -hex 32
SECRET_KEY=
# (if left empty, a random key is generated and saved in data/secret.key)

# Database password (any long random text)
DB_PASSWORD=

# Claude API key from https://console.anthropic.com  (writes the answers)
ANTHROPIC_API_KEY=

# Optional tuning
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low               # low = answers in seconds, high = more careful
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2   # search model, runs locally, 50+ languages incl. Hebrew
# WHISPER_MODEL=small          # speech-to-text size: tiny, base, small, medium, large-v3 (bigger = better, slower)
# SUMMARIZE_INTERVIEWS=true    # turn interview transcripts into structured knowledge notes
# SCAN_INTERVAL_SECONDS=300    # how often to check data/sources for new files
# PORT=8000

# One-click "Connect Google / Microsoft account" (see README "Setting up one-click sign-in")
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# META_APP_ID=          # Facebook and Instagram
# META_APP_SECRET=
# OAUTH_REDIRECT_URL=https://connect.yourcompany.com/oauth.html   # leave empty when testing on http://localhost
